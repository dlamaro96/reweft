# Copy to .env. Bootstrap creates strong local values for fields marked GENERATED.
REWEFT_HTTP_PORT=8080
REWEFT_MODE=synthetic_demo
REWEFT_CONFIG_PATH=/app/config/demo.yaml
REWEFT_DATA_DIR=.data

# GENERATED: at least 32 random bytes. Never commit the generated value.
REWEFT_SECRET_KEY=
POSTGRES_PASSWORD=
TEMPORAL_DB_PASSWORD=

POSTGRES_USER=reweft
POSTGRES_DB=reweft
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_NAME=temporal
DATABASE_URL=postgresql://reweft:${POSTGRES_PASSWORD}@postgres:5432/reweft
TEMPORAL_ADDRESS=temporal:7233

# Optional configured inference; demo mode ignores these and performs no provider call.
REWEFT_INFERENCE_BASE_URL=
REWEFT_INFERENCE_MODEL=
REWEFT_INFERENCE_SECRET_REF=

# The isolated durable integration profile uses a separately generated file at
# .data/real-runtime.env. See deploy/examples/real-runtime.env.example and run
# ./scripts/bootstrap-real-runtime.sh; do not copy real-runtime secrets here.
