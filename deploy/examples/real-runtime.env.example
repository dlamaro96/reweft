# Generated local file lives at .data/real-runtime.env and must not be committed.
REWEFT_REAL_HTTP_PORT=8180
REWEFT_SECRET_KEY=
REWEFT_BOOTSTRAP_TOKEN=
REWEFT_COLLECTOR_SERVICE_TOKEN=
REWEFT_ANALYSIS_SERVICE_TOKEN=

# Compose interpolates inactive legacy profiles too. These values are generated
# for parsing only; every real-runtime service uses the dedicated settings below.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://inactive:inactive@invalid/inactive

REWEFT_DB_ADMIN_USER=reweft_admin
REWEFT_DB_ADMIN_PASSWORD=
REWEFT_APP_DB_USER=reweft_app
REWEFT_APP_DB_PASSWORD=
REWEFT_APP_DB_NAME=reweft

TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=
TEMPORAL_DB_NAME=temporal
TEMPORAL_VISIBILITY_DB_NAME=temporal_visibility

REWEFT_SOURCE_ADMIN_USER=source_admin
REWEFT_SOURCE_ADMIN_PASSWORD=
REWEFT_SOURCE_READER_USER=reweft_reader
REWEFT_SOURCE_READER_PASSWORD=
REWEFT_SOURCE_DB_NAME=loom_source
REWEFT_SOURCE_SCHEMA=ops_atlas
